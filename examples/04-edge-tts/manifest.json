{
  "name": "AudibleWeb — Edge TTS",
  "description": "High-quality neural TTS via Microsoft Edge (~400 voices). Requires internet, no server setup.",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_icon": "icons/idle.png",
    "default_popup": "popup.html"
  },
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [
    "wss://speech.platform.bing.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["contentScript.js"]
    }
  ],
  "background": { "service_worker": "service_worker.js", "type": "module" }
}
