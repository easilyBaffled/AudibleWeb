{
  "name": "AudibleWeb — Piper TTS",
  "description": "Neural TTS using Piper compiled to WebAssembly. No server needed, works offline after first load.",
  "version": "1.0",
  "manifest_version": 3,
  "action": { "default_icon": "icons/idle.png" },
  "permissions": ["tabs", "storage", "offscreen"],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["contentScript.js"]
    }
  ],
  "background": { "service_worker": "service_worker.js" },
  "web_accessible_resources": [
    {
      "resources": ["piper/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "play-pause": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Speak selected text"
    }
  }
}
